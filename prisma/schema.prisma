generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(cuid())
  name         String
  email        String             @unique
  passwordHash String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  projects     Project[]
  templates    QuestionTemplate[]

  @@map("users")
}

model Project {
  id          String             @id @default(cuid())
  name        String
  description String?            @db.Text
  clientName  String?
  color       String             @default("#3B82F6")
  icon        String             @default("folder")
  isArchived  Boolean            @default(false)
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  notes       Note[]
  questions   Question[]
  meetings    Meeting[]
  tasks       FollowUpTask[]
  categories  QuestionCategory[]

  @@index([userId])
  @@map("projects")
}

model Note {
  id        String   @id @default(cuid())
  title     String   @default("Untitled Note")
  content   String   @db.LongText
  isPinned  Boolean  @default(false)
  tags      String?  @db.Text
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("notes")
}

model QuestionCategory {
  id        String     @id @default(cuid())
  name      String
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  questions Question[]
  createdAt DateTime   @default(now())

  @@index([projectId])
  @@map("question_categories")
}

model Question {
  id               String            @id @default(cuid())
  title            String            @db.Text
  details          String?           @db.Text
  category         String            @default("General")
  status           String            @default("PENDING") // PENDING, ASKED, ANSWERED, NEED_FOLLOWUP
  priority         String            @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  forNextMeeting   Boolean           @default(false)
  orderIndex       Int               @default(0)
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  categoryId       String?
  categoryRel      QuestionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  meetingId        String?
  meeting          Meeting?          @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  answers          Answer[]
  meetingQuestions MeetingQuestion[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([projectId])
  @@index([meetingId])
  @@index([status])
  @@map("questions")
}

model Answer {
  id         String   @id @default(cuid())
  content    String   @db.LongText
  author     String?  @default("Client") // Client, Me, Discussion
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([questionId])
  @@map("answers")
}

model Meeting {
  id               String            @id @default(cuid())
  title            String
  meetingDate      DateTime
  purpose          String?           @db.Text
  location         String?           @default("Google Meet")
  attendees        String?           @db.Text
  notes            String?           @db.LongText
  status           String            @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  questions        Question[]
  meetingQuestions MeetingQuestion[]
  tasks            FollowUpTask[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([projectId])
  @@map("meetings")
}

model MeetingQuestion {
  id         String   @id @default(cuid())
  meetingId  String
  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  notes      String?  @db.Text
  createdAt  DateTime @default(now())

  @@unique([meetingId, questionId])
  @@index([meetingId])
  @@index([questionId])
  @@map("meeting_questions")
}

model FollowUpTask {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime?
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  meetingId   String?
  meeting     Meeting?  @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
  @@index([meetingId])
  @@map("follow_up_tasks")
}

model QuestionTemplate {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  content     String   @db.LongText
  isSystem    Boolean  @default(false)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("question_templates")
}
